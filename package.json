  "keywords": [
    "ai",
    "agents",
    "claude",
    "codex",
    "devin",
    "qwen",
    "kimi",
    "mcp",
    "session",
    "history",
    "recall",
    "search"
  ],
  "author": "Sam Cui",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "scrollback": "dist/cli.js"
  },
  "files": [
    "dist",
    "SKILL.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p .",
    "dev": "node scrollback.ts",
    "test": "node --test 'test/*.test.ts'",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
